---
// KineticText.astro - Mechanical Stepped Typography Rotator
interface Props {
  phrases?: string[];
}

const {
  phrases = [
    "ZERO CEREMONY",
    "BUILT-IN SERVERS",
    "TRUE CONCURRENCY",
    "PIPE PIPELINES",
    "LEAVES YOU ALONE",
    "RUST-POWERED CORE"
  ]
} = Astro.props;
---

<div class="relative w-full border border-[#2E2E2E] bg-[#080808] p-4 sm:p-6 md:p-8 select-none overflow-hidden group">
  <!-- Bounding box crosshairs -->
  <span class="absolute -top-2 -left-1.5 font-mono text-xs text-[#666666] select-none" aria-hidden="true">+</span>
  <span class="absolute -top-2 -right-1.5 font-mono text-xs text-[#666666] select-none" aria-hidden="true">+</span>
  <span class="absolute -bottom-2 -left-1.5 font-mono text-xs text-[#666666] select-none" aria-hidden="true">+</span>
  <span class="absolute -bottom-2 -right-1.5 font-mono text-xs text-[#666666] select-none" aria-hidden="true">+</span>

  <!-- Micro Header bar inside container -->
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-[#181818] font-mono text-[11px] tracking-widest uppercase text-[#888888]">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 bg-[#F5F5F5] inline-block animate-pixel-blink"></span>
      <span>[KINETIC_STREAM // REVEAL_ENGINE]</span>
    </div>
    <div class="flex items-center gap-3">
      <span id="kinetic-counter" class="text-[#F5F5F5] font-bold">STATE 01 / 06</span>
      <span class="text-[#404040]">|</span>
      <span>TICK: 2400MS</span>
    </div>
  </div>

  <!-- Mechanical Typography Mask Container -->
  <div class="relative h-20 sm:h-28 md:h-36 lg:h-44 overflow-hidden flex items-center">
    <div id="kinetic-track" class="w-full flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
      {phrases.map((phrase, idx) => (
        <div class="h-20 sm:h-28 md:h-36 lg:h-44 flex items-center justify-between shrink-0">
          <span class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black font-sans uppercase tracking-tightest text-[#F5F5F5] leading-none select-none">
            {phrase}
          </span>
          <span class="hidden sm:inline font-mono text-sm md:text-base text-[#404040] font-bold tracking-widest pl-4">
            [SYS.0{idx + 1}]
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Micro Footer Progress Grid -->
  <div class="pt-4 mt-4 border-t border-[#181818] flex items-center justify-between font-mono text-[10px] tracking-widest text-[#777777] uppercase">
    <div class="flex items-center gap-1.5" id="kinetic-indicators">
      {phrases.map((_, i) => (
        <span
          class={`kinetic-dot w-6 h-1 border border-[#2E2E2E] ${i === 0 ? 'bg-[#FFFFFF] border-[#FFFFFF]' : 'bg-[#181818]'}`}
          data-step={i}
        ></span>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <span>EASING: MECHANICAL_STEPPED</span>
    </div>
  </div>
</div>

<script>
  // Pure lightweight mechanical state cycler (zero external dependencies)
  function initKineticScroller() {
    const track = document.getElementById('kinetic-track');
    const counter = document.getElementById('kinetic-counter');
    const dots = document.querySelectorAll('.kinetic-dot');
    if (!track || !counter) return;

    const totalSteps = 6;
    let currentStep = 0;
    const intervalMs = 2400;

    function setStep(step: number) {
      currentStep = step % totalSteps;
      const percentage = currentStep * (100 / totalSteps);
      track.style.transform = `translateY(-${percentage}%)`;

      counter.textContent = `STATE 0${currentStep + 1} / 0${totalSteps}`;

      dots.forEach((dot, idx) => {
        if (idx === currentStep) {
          dot.classList.add('bg-[#FFFFFF]', 'border-[#FFFFFF]');
          dot.classList.remove('bg-[#181818]', 'border-[#2E2E2E]');
        } else {
          dot.classList.remove('bg-[#FFFFFF]', 'border-[#FFFFFF]');
          dot.classList.add('bg-[#181818]', 'border-[#2E2E2E]');
        }
      });
    }

    // Set initial layout
    track.style.height = `${totalSteps * 100}%`;

    const timer = setInterval(() => {
      setStep(currentStep + 1);
    }, intervalMs);

    // Optional manual clicking on dots
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        setStep(idx);
      });
    });

    // Cleanup if navigation occurs
    document.addEventListener('astro:before-swap', () => {
      clearInterval(timer);
    }, { once: true });
  }

  // Initialize immediately
  initKineticScroller();
  document.addEventListener('astro:page-load', initKineticScroller);
</script>
