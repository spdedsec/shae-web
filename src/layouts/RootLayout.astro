---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SHAE // 1-BIT ARCHITECTURAL SYSTEM",
  description = "Official website of Shae — A high-performance, post-ceremony programming language built on Rust. Swiss Brutalist architecture fused with 1-bit Bayer ditherpunk aesthetics."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[#080808] text-[#F5F5F5]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shae.run" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://shae.run" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#080808] text-[#F5F5F5] selection:bg-[#FFFFFF] selection:text-[#000000] font-sans antialiased min-h-screen flex flex-col justify-between">
    <div class="fixed inset-0 pointer-events-none z-0 bg-halftone opacity-40"></div>
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
