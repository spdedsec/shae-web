---
// Hero.astro - Swiss Brutalist Hero Section with Crosshairs and Kinetic Rotator
import KineticText from './KineticText.astro';
---

<section class="relative w-full border-b border-[#2E2E2E] bg-[#080808] overflow-hidden" aria-labelledby="hero-heading">
  <!-- Crosshair markers at outer section boundaries -->
  <span class="absolute top-2 left-2 font-mono text-xs text-[#555555] pointer-events-none select-none" aria-hidden="true">+</span>
  <span class="absolute top-2 right-2 font-mono text-xs text-[#555555] pointer-events-none select-none" aria-hidden="true">+</span>
  <span class="absolute bottom-2 left-2 font-mono text-xs text-[#555555] pointer-events-none select-none" aria-hidden="true">+</span>
  <span class="absolute bottom-2 right-2 font-mono text-xs text-[#555555] pointer-events-none select-none" aria-hidden="true">+</span>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-24 flex flex-col gap-10">
    <!-- Top Metadata Ledger -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#2E2E2E] pb-4 font-mono text-xs tracking-widest uppercase text-[#888888]">
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 border border-[#404040] text-[#F5F5F5] font-bold">RELEASE // 0.1.0</span>
        <span class="text-[#404040]">//</span>
        <span>INDEX REF: #SHAE-2026-X86</span>
      </div>
      <div class="flex items-center gap-4">
        <span>ARCH: RUST_KERNEL</span>
        <span class="text-[#404040]">+</span>
        <span>LIC: MIT_OPEN_SYSTEM</span>
      </div>
    </div>

    <!-- Massive Headings -->
    <div class="flex flex-col gap-4">
      <div class="flex items-baseline justify-between flex-wrap gap-2">
        <h1 id="hero-heading" class="text-6xl sm:text-8xl md:text-9xl font-black font-sans tracking-tightest uppercase text-[#F5F5F5] leading-none">
          SHAE
        </h1>
        <div class="font-mono text-xs sm:text-sm tracking-widest text-[#888888] uppercase text-right max-w-xs">
          [SWISS BRUTALISM // 1-BIT DITHERPUNK ARCHITECTURE]
        </div>
      </div>

      <!-- Secondary Subheader Manifesto -->
      <p class="text-xl sm:text-2xl md:text-3xl font-normal text-[#D0D0D0] tracking-tight max-w-4xl leading-tight">
        A programming language. It runs, it does stuff, it leaves you alone.
        <span class="text-[#777777] block mt-1">
          Zero ceremony. Built-in HTTP servers. Effortless OS concurrency. Write code, ship it, touch grass.
        </span>
      </p>
    </div>

    <!-- Kinetic Text Reveal Component -->
    <KineticText />

    <!-- Action Bar & Command Telemetry -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-0 border border-[#2E2E2E]">
      <!-- Quick Install Snippet -->
      <div class="md:col-span-7 bg-[#121212] p-4 sm:p-5 flex flex-col justify-between border-b md:border-b-0 md:border-r border-[#2E2E2E]">
        <div class="flex items-center justify-between font-mono text-[11px] tracking-widest text-[#888888] uppercase mb-2">
          <span>01 // RAPID INSTALLATION (CARGO)</span>
          <span class="text-[#555555]">BASH</span>
        </div>
        <div class="flex items-center justify-between gap-4 font-mono text-xs sm:text-sm bg-[#080808] p-3 border border-[#2E2E2E] text-[#F5F5F5]">
          <code class="overflow-x-auto whitespace-nowrap scrollbar-none">
            <span class="text-[#777777]">$</span> cargo install --git https://github.com/spdedsec/shae
          </code>
          <button
            id="copy-install-btn"
            class="px-2.5 py-1 bg-[#181818] border border-[#404040] text-[#F5F5F5] font-mono text-[10px] tracking-widest uppercase hover:bg-white hover:text-black transition-none shrink-0"
            aria-label="Copy installation command"
          >
            COPY
          </button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="md:col-span-5 grid grid-cols-2 divide-x divide-[#2E2E2E]">
        <a
          href="https://github.com/spdedsec/shae"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-5 bg-[#080808] text-[#F5F5F5] font-mono text-xs tracking-widest uppercase hover:bg-white hover:text-black transition-none text-center group"
        >
          <span class="text-sm font-bold font-sans">REPOSITORY</span>
          <span class="text-[10px] text-[#777777] group-hover:text-black mt-1">[GITHUB // SHAE]</span>
        </a>
        <a
          href="#specs"
          class="flex flex-col items-center justify-center p-5 bg-[#080808] text-[#F5F5F5] font-mono text-xs tracking-widest uppercase hover:bg-white hover:text-black transition-none text-center group"
        >
          <span class="text-sm font-bold font-sans">SPECIFICATION</span>
          <span class="text-[10px] text-[#777777] group-hover:text-black mt-1">[DOCS &amp; SYNTAX]</span>
        </a>
      </div>
    </div>

    <!-- Specs Barometer Indicators -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-0 border-t border-b border-[#2E2E2E] divide-y sm:divide-y-0 sm:divide-x divide-[#2E2E2E] font-mono text-xs uppercase">
      <div class="p-4 flex flex-col gap-1">
        <span class="text-[10px] text-[#777777] tracking-widest">COLD START LATENCY</span>
        <span class="text-base sm:text-lg font-bold text-[#F5F5F5]">&lt; 1.2 MILLISECONDS</span>
      </div>
      <div class="p-4 flex flex-col gap-1">
        <span class="text-[10px] text-[#777777] tracking-widest">RESIDENT MEMORY</span>
        <span class="text-base sm:text-lg font-bold text-[#F5F5F5]">~ 3.4 MEGABYTES</span>
      </div>
      <div class="p-4 flex flex-col gap-1">
        <span class="text-[10px] text-[#777777] tracking-widest">CONCURRENCY MODEL</span>
        <span class="text-base sm:text-lg font-bold text-[#F5F5F5]">OS WORKER THREADS</span>
      </div>
      <div class="p-4 flex flex-col gap-1">
        <span class="text-[10px] text-[#777777] tracking-widest">EXTERNAL RUNTIMES</span>
        <span class="text-base sm:text-lg font-bold text-[#F5F5F5]">ZERO DEPENDENCIES</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple copy clipboard button
  const copyBtn = document.getElementById('copy-install-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('cargo install --git https://github.com/spdedsec/shae').then(() => {
        const prevText = copyBtn.textContent;
        copyBtn.textContent = 'COPIED!';
        setTimeout(() => {
          copyBtn.textContent = prevText;
        }, 1500);
      });
    });
  }
</script>
